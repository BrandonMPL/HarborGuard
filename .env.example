# HarborGuard environment configuration (TEMPLATE)
# Copy this file to .env and fill in real values. Never commit .env.
# .env is gitignored; .env.example is the committed template.

# ---- AI provider (server-side only; never exposed to the browser) ----
# API key for the AI provider used by server/aiService.ts
AI_API_KEY=
# Model identifier (e.g. a chat/completion model name from your provider)
AI_MODEL=
# Optional: override the provider base URL if not using the SDK default
# AI_BASE_URL=

# ---- Server ----
# Port the Express AI endpoint listens on (Vite dev proxy forwards /api here)
PORT=8787