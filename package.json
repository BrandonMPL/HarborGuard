        "@turf/nearest-point-on-line": "^7.1.0",
        "leaflet": "^1.9.4",
        "openai": "^4.67.3",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-leaflet": "^4.2.1"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/geojson": "^7946.0.16",
        "@types/leaflet": "^1.9.12",
        "@types/node": "^26.6.5",
        "@types/react": "^18.3.11",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.3.2",
        "autoprefixer": "^10.4.20",
        "concurrently": "^9.0.1",
        "dotenv": "^18.0.9",
        "express": "^4.21.0",
        "postcss": "^8.4.47",
